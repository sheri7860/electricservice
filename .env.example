# Canonical origin (defaults to https://brightlaneelectric.com)
NEXT_PUBLIC_SITE_URL=
# Main phone. Unset = temporary (555) 010-0142 placeholder, kept out of schema.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_PHONE_E164=
# Call-tracking number used on /lp/* pages (optional)
NEXT_PUBLIC_PPC_TRACKING_PHONE=
# Contact facts: hidden when empty
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_HOURS=
# "true" ONLY if calls are answered 24/7. Controls every 24/7 claim.
NEXT_PUBLIC_EMERGENCY_24_7=
# Analytics / verification: nothing loads when empty
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Lead delivery (HMAC-signed). Production refuses leads with no destination.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
LEAD_IP_SALT=

# IndexNow (optional; defaults to the 32-hex key file in public/)
INDEXNOW_KEY=
